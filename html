<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MARIOS - Film & Canlı TV Platformu</title>
    <!-- M3U8 / HLS Yayınları Oynatmak İçin Gerekli Kütüphane -->
    <script src="https://jsdelivr.net"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #141414;
            color: #ffffff;
            overflow-x: hidden;
        }
        /* Üst Menü */
        header {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 15px 4%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(to bottom, rgba(0,0,0,0.95) 30%, rgba(0,0,0,0));
            z-index: 1000;
            flex-wrap: wrap;
            gap: 15px;
        }
        .header-left {
            display: flex;
            align-items: center;
            gap: 25px;
        }
        .logo {
            color: #E50914;
            font-size: 32px;
            font-weight: 900;
            letter-spacing: 3px;
            text-transform: uppercase;
            text-decoration: none;
        }
        nav a {
            color: #e5e5e5;
            text-decoration: none;
            margin-right: 18px;
            font-size: 15px;
            font-weight: 500;
            transition: color 0.3s;
        }
        nav a:hover {
            color: #ffffff;
        }
        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .search-box {
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid #555;
            color: white;
            padding: 8px 14px;
            border-radius: 4px;
            font-size: 14px;
            width: 220px;
            outline: none;
        }
        .search-box:focus {
            border-color: #E50914;
        }
        .btn-add {
            background: #222;
            color: #fff;
            border: 1px solid #E50914;
            padding: 8px 14px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 13px;
            font-weight: bold;
            transition: 0.2s;
        }
        .btn-add:hover {
            background: #E50914;
        }

        /* Ana Vitrin */
        .hero {
            height: 70vh;
            background: linear-gradient(to top, #141414 10%, transparent 90%),
                        linear-gradient(to right, rgba(0,0,0,0.85) 35%, transparent 100%),
                        url('https://unsplash.com') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 0 4%;
        }
        .hero h1 {
            font-size: 3.4rem;
            margin-bottom: 12px;
            max-width: 650px;
        }
        .hero p {
            font-size: 1.1rem;
            color: #cccccc;
            max-width: 520px;
            margin-bottom: 25px;
            line-height: 1.5;
        }
        .btn-play {
            background-color: #E50914;
            color: white;
            border: none;
            padding: 12px 28px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 4px;
            cursor: pointer;
            width: fit-content;
            transition: background 0.2s;
        }
        .btn-play:hover {
            background-color: #f40612;
        }

        /* Kategori Filtreleri */
        .filter-bar {
            padding: 10px 4% 0;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }
        .filter-btn {
            background: #222;
            color: #ccc;
            border: 1px solid #333;
            padding: 6px 16px;
            border-radius: 20px;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.2s;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #E50914;
            color: white;
            border-color: #E50914;
        }

        /* İçerik Satırları */
        .row {
            padding: 25px 4% 10px;
        }
        .row h2 {
            font-size: 1.35rem;
            margin-bottom: 15px;
            color: #e5e5e5;
        }
        .cards {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding-bottom: 15px;
        }
        .cards::-webkit-scrollbar {
            height: 6px;
        }
        .cards::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 3px;
        }
        .card {
            min-width: 245px;
            height: 145px;
            background-color: #222;
            border-radius: 6px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
            transition: transform 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 12px;
            border: 1px solid #333;
        }
        .card:hover {
            transform: scale(1.07);
            border-color: #E50914;
            z-index: 10;
        }
        .card-title {
            font-weight: bold;
            font-size: 1rem;
            z-index: 2;
            text-shadow: 1px 1px 4px black;
        }
        .card-tag {
            font-size: 0.75rem;
            color: #E50914;
            font-weight: bold;
            z-index: 2;
            margin-bottom: 3px;
        }
        .card-bg {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            object-fit: cover;
            opacity: 0.5;
            z-index: 1;
        }
        .delete-item {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0,0,0,0.7);
            color: #ff4d4d;
            border: none;
            border-radius: 50%;
            width: 24px;
            height: 24px;
            font-size: 12px;
            cursor: pointer;
            z-index: 3;
            display: none;
        }
        .card:hover .delete-item {
            display: block;
        }

        /* Modal (Video Oynatıcı & İçerik Ekleme Penceresi) */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.92);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        .modal-content {
            width: 85%;
            max-width: 960px;
            aspect-ratio: 16/9;
            background: #000;
            position: relative;
            border: 2px solid #333;
        }
        .close-btn {
            color: white;
            font-size: 26px;
            font-weight: bold;
            cursor: pointer;
            margin-bottom: 10px;
            align-self: flex-end;
            margin-right: 7.5%;
        }
        .close-btn:hover {
            color: #E50914;
        }
        iframe, video {
            width: 100%;
            height: 100%;
            border: none;
            background: #000;
        }

        /* İçerik Ekleme Formu */
        .add-form-box {
            background: #1f1f1f;
            padding: 30px;
            border-radius: 8px;
            width: 90%;
            max-width: 450px;
            border: 1px solid #333;
        }
        .add-form-box h3 {
            margin-bottom: 20px;
            color: #E50914;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            font-size: 13px;
            margin-bottom: 5px;
            color: #ccc;
        }
        .form-group input, .form-group select {
            width: 100%;
            padding: 10px;
            background: #141414;
            border: 1px solid #444;
            color: white;
            border-radius: 4px;
            outline: none;
        }
        .form-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <!-- Üst Menü -->
    <header>
        <div class="header-left">
            <a href="#" class="logo">MARIOS</a>
            <nav>
                <a href="#canli-tv">Canlı TV</a>
                <a href="#filmler">Filmler</a>
            </nav>
        </div>
        <div class="header-right">
            <input type="text" id="searchInput" class="search-box" placeholder="Kanal veya film ara..." onkeyup="filterContent()">
            <button class="btn-add" onclick="openAddModal()">+ İçerik Ekle</button>
        </div>
    </header>

    <!-- Ana Vitrin -->
    <section class="hero">
        <h1>MARIOS Sinema & TV</h1>
        <p>Canlı Türk TV kanalları, M3U8 yayın akışları ve seçkin sinema arşivi tek ekranda.</p>
        <button class="btn-play" onclick="openPlayer('https://youtube.com')">▶ Canlı Yayını Başlat</button>
    </section>

    <!-- Kategori Filtreleri -->
    <div class="filter-bar">
        <button class="filter-btn active" onclick="setCategory('ALL', this)">Tümü</button>
        <button class="filter-btn" onclick="setCategory('HABER', this)">Haber Kanalları</button>
        <button class="filter-btn" onclick="setCategory('BELGESEL', this)">Belgesel</button>
        <button class="filter-btn" onclick="setCategory('FİLM', this)">Filmler</button>
    </div>

    <!-- Canlı TV Bölümü -->
let currentCategory = 'ALL';
let hlsInstance = null;
// Varsayılan Veriler
const defaultTv = [
{
id: 1,
name: "TRT Haber Canlı",
category: "HABER • CANLI",
filterType: "HABER",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 2,
name: "TRT Belgesel Canlı",
category: "BELGESEL • CANLI",
filterType: "BELGESEL",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 3,
name: "NTV Canlı Yayın",
category: "HABER • CANLI",
filterType: "HABER",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 4,
name: "Habertürk TV",
category: "HABER • CANLI",
filterType: "HABER",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 5,
name: "CNN Türk Canlı",
category: "HABER • CANLI",
filterType: "HABER",
img: "unsplash.com",
url: "youtube.com"
}
];
const defaultMovies = [
{
id: 101,
name: "Tears of Steel (Bilim Kurgu - Tam Film)",
category: "FİLM • 4K",
filterType: "FİLM",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 102,
name: "Sintel (Fantastik Animasyon - Tam Film)",
category: "FİLM • HD",
filterType: "FİLM",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 103,
name: "Spring (Macera / Fantastik - Tam Film)",
category: "FİLM • HD",
filterType: "FİLM",
img: "unsplash.com",
url: "youtube.com"
},
{
id: 104,
name: "Big Buck Bunny (Komedi - Tam Film)",
category: "FİLM • HD",
filterType: "FİLM",
img: "unsplash.com",
url: "youtube.com"
}
];
// Tarayıcı Hafızasından Verileri Çek
let tvChannels = JSON.parse(localStorage.getItem('marios_tv')) || defaultTv;
let movies = JSON.parse(localStorage.getItem('marios_movies')) || defaultMovies;
function renderCards(list, containerId, sectionType) {
const container = document.getElementById(containerId);
const searchText = document.getElementById('searchInput').value.toLowerCase();
container.innerHTML = '';
const filtered = list.filter(item => {
const matchesSearch = item.name.toLowerCase().includes(searchText);
const matchesCat = currentCategory === 'ALL' || item.filterType === currentCategory;
return matchesSearch && matchesCat;
});
filtered.forEach(item => {
const card = document.createElement('div');
card.className = 'card';
card.onclick = (e) => {
if (!e.target.classList.contains('delete-item')) {
openPlayer(item.url);
}
};
card.innerHTML = <button class="delete-item" title="Sil" onclick="deleteItem(${item.id}, '${sectionType}')">✕</button> <img src="${item.img}" alt="${item.name}" class="card-bg"> <span class="card-tag">${item.category}</span> <div class="card-title">${item.name}</div>;
container.appendChild(card);
});
}
function setCategory(cat, btn) {
currentCategory = cat;
document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
btn.classList.add('active');
filterContent();
}
function filterContent() {
renderCards(tvChannels, 'tv-list', 'tv');
renderCards(movies, 'movie-list', 'movie');
}
// Hem YouTube Hem de .m3u8 (HLS) Destekli Oynatıcı
function openPlayer(url) {
const modal = document.getElementById('videoModal');
const frame = document.getElementById('videoFrame');
const video = document.getElementById('hlsVideo');
modal.style.display = 'flex';
if (url.includes('.m3u8')) {
frame.style.display = 'none';
frame.src = '';
video.style.display = 'block';
if (Hls.isSupported()) {
if (hlsInstance) hlsInstance.destroy();
hlsInstance = new Hls();
hlsInstance.loadSource(url);
hlsInstance.attachMedia(video);
hlsInstance.on(Hls.Events.MANIFEST_PARSED, () => video.play());
} else if (video.canPlayType('application/vnd.apple.mpegurl')) {
video.src = url;
video.play();
}
} else {
video.style.display = 'none';
video.pause();
frame.style.display = 'block';
frame.src = url + (url.includes('?') ? '&autoplay=1' : '?autoplay=1');
}
}
function closePlayer() {
const modal = document.getElementById('videoModal');
const frame = document.getElementById('videoFrame');
const video = document.getElementById('hlsVideo');
frame.src = '';
video.pause();
video.src = '';
if (hlsInstance) {
hlsInstance.destroy();
hlsInstance = null;
}
modal.style.display = 'none';
}
// İçerik Ekleme Modal İşlemleri
function openAddModal() {
document.getElementById('addModal').style.display = 'flex';
}
function closeAddModal() {
document.getElementById('addModal').style.display = 'none';
}
function saveNewItem() {
const section = document.getElementById('itemSection').value;
const name = document.getElementById('itemName').value.trim();
const filterType = document.getElementById('itemFilter').value;
const url = document.getElementById('itemUrl').value.trim();
const img = document.getElementById('itemImg').value.trim() || "unsplash.com";
if (!name || !url) {
alert("Lütfen içerik adı ve yayın linki alanlarını doldurun.");
return;
}
const newItem = {
id: Date.now(),
name: name,
category: ${filterType} • ÖZEL,
filterType: filterType,
img: img,
url: url
};
if (section === 'tv') {
tvChannels.push(newItem);
localStorage.setItem('marios_tv', JSON.stringify(tvChannels));
} else {
movies.push(newItem);
localStorage.setItem('marios_movies', JSON.stringify(movies));
}
document.getElementById('itemName').value = '';
document.getElementById('itemUrl').value = '';
document.getElementById('itemImg').value = '';
closeAddModal();
filterContent();
}
function deleteItem(id, section) {
if (section === 'tv') {
tvChannels = tvChannels.filter(item => item.id !== id);
localStorage.setItem('marios_tv', JSON.stringify(tvChannels));
} else {
movies = movies.filter(item => item.id !== id);
localStorage.setItem('marios_movies', JSON.stringify(movies));
}
filterContent();
}
filterContent();
